{
  "name": "freehub-typescript-spike",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"tsx watch src/server.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "tsx --test test/**/*.test.ts",
    "test:api": "tsx --test test/api.test.ts",
    "test:visual": "playwright test",
    "openapi": "tsx scripts/write-openapi.ts",
    "check": "npm run prisma:generate && tsc --noEmit && tsc -p tsconfig.server.json --noEmit && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^8.1.0",
    "@fastify/swagger": "^9.4.2",
    "@prisma/client": "^6.6.0",
    "@sinclair/typebox": "^0.34.13",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3"
  }
}
