# Use an immutable registry digest in production, for example registry.example/freehub@sha256:...
FREEHUB_IMAGE=freehub:pilot
FREEHUB_DOMAIN=freehub.example.org
FREEHUB_PUBLIC_HTTP_PORT=80
FREEHUB_PUBLIC_HTTPS_PORT=443
FREEHUB_HTTP_PORT=3001
FREEHUB_CONTAINER_PORT=3001
POSTGRES_DB=freehub
POSTGRES_USER=freehub
LOG_LEVEL=info
COOKIE_SECURE=true
FREEHUB_SECRETS_DIR=./secrets
