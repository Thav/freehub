<h1>People</h1><%= form_with url: organization_people_path(@organization), method: :get do |form| %><%= form.label :q, "Search people" %><%= form.search_field :q, value: params[:q] %><%= form.submit "Search" %><% end %><p><%= link_to "Export CSV", organization_reports_people_path(@organization, format: :csv) %></p><ul><% @people.each do |person| %><li><%= link_to person.display_name, organization_person_path(@organization, person) %></li><% end %></ul>
